# Phase 2 default: separate mock backend. Keep LLM settings unset in mock mode.
INFERENCE_MODE=mock
MOCK_BACKEND_URL=http://127.0.0.1:8001
REQUEST_TIMEOUT_SECONDS=60
MAX_PROMPT_CHARS=20000

# Real vLLM/OpenAI-compatible mode example. Uncomment all three to use it.
# INFERENCE_MODE=real
# LLM_PROVIDER=vllm
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_API_KEY=
# LLM_MODEL_ID=your-served-model-id
# LLM_VERIFY_MODEL_ID=true
# LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_TOKENIZER_ID=optional-local-HuggingFace-tokenizer
# LLM_MAX_CONTEXT_TOKENS=
# For Ollama use the independent settings below.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# BACKEND_OLLAMA_MODEL=gemma4:12b
# WORKLOAD_EXCEL_PATH=./backend/data/D07_150_Questions_Token_Predictor.xlsx

# Scheduler and safe planning-only scaling defaults.
SCHEDULER_POLICY=fifo
SCHEDULER_MAX_WAIT_SECONDS=2
STARVATION_THRESHOLD_MS=2000
SCHEDULER_MAX_QUEUE=1000
SCALING_MIN_REPLICAS=0
SCALING_MAX_REPLICAS=3
SCALING_DRY_RUN=true
DATABASE_URL=sqlite:///./scheduler.db
ENABLE_DEV_FAULT_INJECTION=false
HEALTH_CHECK_INTERVAL_SECONDS=10
MAX_REQUEST_BYTES=1000000
# CORS_ORIGINS=https://dashboard.example
# MANAGEMENT_API_KEY=optional-secret-for-management-endpoints
DOCKER_WORKER_MANAGER_ENABLED=true
DOCKER_WORKER_IDLE_TIMEOUT_SECONDS=10
